{
  "name": "buscador-homebrew",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "collect": "node --experimental-strip-types scripts/collect.mjs",
    "summaries": "node --experimental-strip-types scripts/summaries.mjs",
    "check:feed": "node scripts/check-feed.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "node --experimental-strip-types --test src/library.test.ts src/core/core.test.ts scripts/collector.test.mjs scripts/summaries.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "6.4.6"
  }
}
